# EchoMuse Controller — copy to .env and fill in values

# ── Network ──────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
# Device WebSockets: /device/v1/control, /device/v1/audio, /device/v1/assets;
# retained /shell; upgrade-only legacy /control.
SERVER_PORT=8767
# TLS device-link listener; 0 disables it. Require TLS only after every device
# has its pushed CA/token and is connected by wss.
SERVER_TLS_PORT=8770
REQUIRE_DEVICE_TLS=0
# Dashboard/API
API_PORT=8768
# LAN IP advertised by mDNS; must be reachable from Echo Dots. If unset, the
# default-route interface's address is advertised (with a warning in the log).
SERVER_IP=10.x.y.z
MDNS_NAME=echomuse

# ── Home Assistant (Docker / bare metal) ─────────────────────────────────────
# Base URL and an administrator long-lived access token (SPEC §16.7).
# The HA add-on does not set these: `homeassistant_api: true` injects
# SUPERVISOR_TOKEN and the controller connects through Supervisor.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-long-lived-access-token

# ── Satellite identity ───────────────────────────────────────────────────────
# Project version reported by each emulated ESPHome satellite.
ESPHOME_PROJECT_VERSION=2.0.0

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=/app/data/echomuse.db

# ── Device firmware ──────────────────────────────────────────────────────────
# The one firmware build this controller installs on Dots: a directory holding
# `server` and `version`. The image carries it at /app/firmware; bare metal
# points this at device/build, which device/compile.sh fills. The controller
# refuses to start without it.
# FIRMWARE_DIR=../device/build

# ── Device approval ──────────────────────────────────────────────────────────
# strict: admin approval; auto: approve as "Unknown {serial[:8]}".
DEVICE_APPROVAL=strict
